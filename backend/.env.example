# =============================================================================
# PortFlow Backend Environment Configuration
# =============================================================================

# Server Port (Render defaults to 10000)
PORT=10000

# Environment Mode ('development' or 'production')
NODE_ENV=production

# Supabase PostgreSQL Connection Strings
# DATABASE_URL: Transaction Pooler connection on Port 6543 with PgBouncer (for high-volume API requests)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct session connection on Port 5432 (required by Prisma for schema sync/migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional Supabase credentials (for direct Supabase client access if used)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_KEY="[YOUR-SUPABASE-ANON-KEY]"

# JWT Secret Key for token signing and authentication (32+ random characters)
JWT_SECRET="replace-with-a-random-32-plus-character-secret"

# Allowed CORS Origin(s) - set to your Vercel frontend URL in production, or comma-separated list
CORS_ORIGIN="https://your-portflow-frontend.vercel.app"

