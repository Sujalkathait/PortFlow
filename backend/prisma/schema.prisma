// =============================================================================
// PortFlow Database Schema - Prisma ORM Definition
// Database Provider: PostgreSQL (Supabase / Standard PostgreSQL 14+)
// Architecture: Relational Data Model with Soft-Delete and Performance B-Tree Indexes
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// 1. Users Model
// Represents authenticated operators and administrators.
// Passwords stored as one-way cryptographic bcrypt hashes.
// -----------------------------------------------------------------------------
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  full_name     String    @db.VarChar(120)
  role          String    @default("Operator") @db.VarChar(50)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by    String?   @db.VarChar(255)

  @@index([deleted_at])
  @@index([created_at(sort: Desc)])
  @@map("users")
}

// -----------------------------------------------------------------------------
// 2. Ships Model
// Represents marine vessels calling at the port terminal.
// Uses IMO (International Maritime Organization) unique registration identifier.
// -----------------------------------------------------------------------------
model Ship {
  id           Int       @id @default(autoincrement())
  imo_number   String    @unique @db.VarChar(100)
  name         String    @db.VarChar(120)
  vessel_type  String    @default("General Cargo") @db.VarChar(100)
  capacity_teu Int       @default(0)
  status       String    @default("Arriving") @db.VarChar(50)
  berth_id     String?   @db.VarChar(50)
  created_by   String    @default("system") @db.VarChar(255)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)
  deleted_by   String?   @db.VarChar(255)

  @@index([status])
  @@index([deleted_at])
  @@index([created_at(sort: Desc)])
  @@map("ships")
}

// -----------------------------------------------------------------------------
// 3. Cargo Model
// Represents shipping containers and freight manifests.
// Tracked across port zones (Yard, Ship, Transit, Gate).
// -----------------------------------------------------------------------------
model Cargo {
  id               Int       @id @default(autoincrement())
  cargo_number     String    @unique @db.VarChar(100)
  size_type        String    @default("20ft") @db.VarChar(50)
  weight_tons      Float     @default(0.0) @db.DoublePrecision
  cargo_type       String    @default("General") @db.VarChar(100)
  current_location String    @default("Yard") @db.VarChar(100)
  ship_name        String    @default("") @db.VarChar(120)
  status           String    @default("On Ship") @db.VarChar(50)
  created_by       String    @default("system") @db.VarChar(255)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)
  deleted_by       String?   @db.VarChar(255)

  @@index([status])
  @@index([deleted_at])
  @@index([created_at(sort: Desc)])
  @@map("cargo")
}

// -----------------------------------------------------------------------------
// 4. Equipment Model
// Represents shared port physical resources (Berths, STS Cranes, Yard Trucks).
// Managed by OS Resource Allocator (Mutex and Counting Semaphores).
// -----------------------------------------------------------------------------
model Equipment {
  id           Int       @id @default(autoincrement())
  equipment_id String    @unique @db.VarChar(50)
  name         String    @db.VarChar(120)
  type         String    @default("Berth") @db.VarChar(50)
  status       String    @default("Available") @db.VarChar(50)
  assigned_to  String?   @db.VarChar(100)
  created_by   String    @default("system") @db.VarChar(255)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)
  deleted_by   String?   @db.VarChar(255)

  @@index([type])
  @@index([status])
  @@index([deleted_at])
  @@map("equipment")
}

// -----------------------------------------------------------------------------
// 5. Operations Model
// Core OS-level process representation.
// Each operation maps to a Process Control Block (PCB) scheduled via FCFS, SJF,
// Round Robin, or Priority algorithms.
// -----------------------------------------------------------------------------
model Operation {
  id                 Int       @id @default(autoincrement())
  process_id         String?   @unique @db.VarChar(50)
  operation_type     String    @db.VarChar(100)
  ship_name          String    @db.VarChar(120)
  crane_id           String    @default("None") @db.VarChar(50)
  berth_id           String    @default("Berth 1") @db.VarChar(50)
  priority           Int       @default(1)
  status             String    @default("Queued") @db.VarChar(50)
  start_time         DateTime? @db.Timestamptz(6)
  end_time           DateTime? @db.Timestamptz(6)
  waiting_time_ms    Int?
  turnaround_time_ms Int?
  created_by         String    @default("system") @db.VarChar(255)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)
  deleted_by         String?   @db.VarChar(255)

  @@index([status])
  @@index([deleted_at])
  @@index([created_at(sort: Desc)])
  @@index([process_id])
  @@map("operations")
}
