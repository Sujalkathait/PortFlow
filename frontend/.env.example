# =============================================================================
# PortFlow Frontend Environment Configuration
# =============================================================================

# Backend REST API Base URL (point to your deployed Render URL in production)
# In Vercel, set this to: https://portflow-9p4m.onrender.com/api
VITE_API_BASE_URL=https://portflow-9p4m.onrender.com/api

# Optional: Supabase Client Credentials
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=[YOUR-SUPABASE-ANON-KEY]

