# =============================================================================
# PortFlow Unified Monorepo Environment Reference
# =============================================================================
# This monorepo consists of a decoupled Express backend and React frontend.
# Copy the appropriate variables into backend/.env and frontend/.env:

# -----------------------------------------------------------------------------
# 1. Backend Environment Variables (backend/.env)
# -----------------------------------------------------------------------------
# PORT=10000
# NODE_ENV=development
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# JWT_SECRET="your-32-plus-character-secret-key"
# CORS_ORIGIN="http://localhost:5173"

# -----------------------------------------------------------------------------
# 2. Frontend Environment Variables (frontend/.env)
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL="https://portflow-9p4m.onrender.com/api"
# VITE_SUPABASE_URL="https://[REF].supabase.co"
# VITE_SUPABASE_PUBLISHABLE_KEY="[YOUR-ANON-KEY]"

